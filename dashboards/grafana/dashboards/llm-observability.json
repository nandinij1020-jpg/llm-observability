{
  "uid": "llm-observability",
  "title": "LLM Agent Observability",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "1m",
  "tags": [
    "llm",
    "bedrock",
    "observability"
  ],
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "custom",
        "label": "Environment",
        "query": "dev,staging,prod",
        "current": {
          "text": "dev",
          "value": "dev"
        },
        "options": [
          {
            "text": "dev",
            "value": "dev",
            "selected": true
          },
          {
            "text": "staging",
            "value": "staging",
            "selected": false
          },
          {
            "text": "prod",
            "value": "prod",
            "selected": false
          }
        ]
      },
      {
        "name": "agent",
        "type": "query",
        "label": "Agent",
        "datasource": {
          "type": "cloudwatch",
          "uid": "cloudwatch"
        },
        "multi": true,
        "includeAll": true,
        "refresh": 2,
        "query": {
          "queryType": "dimensionValues",
          "region": "default",
          "namespace": "LLMObservability/$env",
          "metricName": "Requests",
          "dimensionKey": "AgentId",
          "refId": "agent"
        },
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Agent runs",
      "type": "stat",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "LLMObservability/$env",
          "metricName": "Requests",
          "dimensions": {
            "AgentId": "ALL"
          },
          "matchExact": true,
          "statistic": "Sum",
          "period": "",
          "id": "a",
          "hide": false,
          "label": "runs"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
